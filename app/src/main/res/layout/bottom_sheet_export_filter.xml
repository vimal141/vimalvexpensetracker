<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:paddingHorizontal="@dimen/_14sdp"
    android:paddingTop="@dimen/_10sdp"
    android:paddingBottom="@dimen/_20sdp">

    <!-- Drag Handle -->
    <View
        android:id="@+id/dragHandle"
        android:layout_width="@dimen/_36sdp"
        android:layout_height="@dimen/_4sdp"
        android:background="@drawable/bg_button"
        android:backgroundTint="@color/divider_color"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Title -->
    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/tvTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_12sdp"
        android:fontFamily="@font/bold"
        android:text="@string/export_data"
        android:textColor="@color/TextColor"
        android:textSize="@dimen/_18ssp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/dragHandle" />

    <!-- Subheader Section Label -->
    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/lblPeriod"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_10sdp"
        android:fontFamily="@font/medium"
        android:letterSpacing="0.08"
        android:paddingBottom="@dimen/_4sdp"
        android:text="@string/statement_period"
        android:textAllCaps="true"
        android:textColor="@color/subTextColor"
        android:textSize="@dimen/_9ssp"
        android:textAlignment="viewStart"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTitle" />



        <RadioGroup
            android:id="@+id/rgPeriod"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_5sdp"
            app:layout_constraintTop_toBottomOf="@+id/lblPeriod"
            android:orientation="vertical">

            <!-- This Month -->
            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/rbThisMonth"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_44sdp"
                android:background="?attr/selectableItemBackground"
                android:fontFamily="@font/semi_bold"
                android:paddingHorizontal="@dimen/_12sdp"
                android:text="@string/this_month"
                android:textColor="@color/TextColor"
                android:textSize="@dimen/_13ssp"
                app:buttonTint="@color/radio_button_tint"
                app:rippleColor="@android:color/transparent" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0.8dp"
                android:background="@color/divider_color" />

            <!-- Last 3 Months -->
            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/rbLast3Months"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_44sdp"
                android:background="?attr/selectableItemBackground"
                android:fontFamily="@font/semi_bold"
                android:paddingHorizontal="@dimen/_12sdp"
                android:text="@string/last_3_months"
                android:textColor="@color/TextColor"
                android:textSize="@dimen/_13ssp"
                app:buttonTint="@color/radio_button_tint"
                app:rippleColor="@android:color/transparent" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0.8dp"
                android:background="@color/divider_color" />

            <!-- Last 6 Months -->
            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/rbLast6Months"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_44sdp"
                android:background="?attr/selectableItemBackground"
                android:fontFamily="@font/semi_bold"
                android:paddingHorizontal="@dimen/_12sdp"
                android:text="@string/last_6_months"
                android:textColor="@color/TextColor"
                android:textSize="@dimen/_13ssp"
                app:buttonTint="@color/radio_button_tint"
                app:rippleColor="@android:color/transparent" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0.8dp"
                android:background="@color/divider_color" />

            <!-- This Year -->
            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/rbThisYear"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_44sdp"
                android:background="?attr/selectableItemBackground"
                android:fontFamily="@font/semi_bold"
                android:paddingHorizontal="@dimen/_12sdp"
                android:text="@string/this_year"
                android:textColor="@color/TextColor"
                android:textSize="@dimen/_13ssp"
                app:buttonTint="@color/radio_button_tint"
                app:rippleColor="@android:color/transparent" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0.8dp"
                android:background="@color/divider_color" />

            <!-- All Time -->
            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/rbAllTime"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_44sdp"
                android:background="?attr/selectableItemBackground"
                android:checked="true"
                android:fontFamily="@font/semi_bold"
                android:paddingHorizontal="@dimen/_12sdp"
                android:text="@string/all_time"
                android:textColor="@color/TextColor"
                android:textSize="@dimen/_13ssp"
                app:buttonTint="@color/radio_button_tint"
                app:rippleColor="@android:color/transparent" />

        </RadioGroup>


    <!-- Action Button Next -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnNext"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_44sdp"
        android:layout_marginTop="@dimen/_16sdp"
        android:fontFamily="@font/bold"
        android:text="@string/next"
        android:textAllCaps="false"
        android:textColor="@android:color/white"
        android:textSize="@dimen/_13ssp"
        app:backgroundTint="@color/primaryColor"
        app:cornerRadius="@dimen/_12sdp"
        app:elevation="0dp"
        app:layout_constraintTop_toBottomOf="@id/rgPeriod" />

</androidx.constraintlayout.widget.ConstraintLayout>
