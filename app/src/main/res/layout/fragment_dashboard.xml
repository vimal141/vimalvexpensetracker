<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bgColor">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bgColor"
        android:fillViewport="true"
        android:scrollbars="none">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/fragmentTittle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/bold"
                android:maxLines="1"
                android:paddingHorizontal="@dimen/_14sdp"
                android:paddingVertical="@dimen/_12sdp"
                android:text="@string/nav_dashboard"
                android:textAlignment="viewStart"
                android:textColor="@color/TextColor"
                android:textSize="@dimen/_22ssp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layoutMonthSelector"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_14sdp"
                android:layout_marginTop="@dimen/_4sdp"
                android:background="@android:color/transparent"
                app:layout_constraintEnd_toEndOf="@+id/cardBalance"
                app:layout_constraintStart_toStartOf="@+id/cardBalance"
                app:layout_constraintTop_toBottomOf="@+id/fragmentTittle">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnPrevMonth"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:elevation="0dp"
                    app:cardBackgroundColor="@color/bgColorCard"
                    app:cardCornerRadius="@dimen/_57ssp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/cardMonthSelector"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:rippleColor="@android:color/transparent"
                    app:shapeAppearance="@style/ShapeAppearance.Material3.Corner.Full"
                    app:strokeColor="@color/divider_color"
                    app:strokeWidth="0.3dp">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="@dimen/_24sdp"
                        android:layout_height="@dimen/_24sdp"
                        android:padding="@dimen/_4sdp"
                        android:src="@drawable/ic_left"
                        app:tint="@color/primaryColor" />

                </com.google.android.material.card.MaterialCardView>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cardMonthSelector"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:paddingVertical="@dimen/_4sdp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/btnNextMonth"
                    app:layout_constraintStart_toEndOf="@id/btnPrevMonth"
                    app:layout_constraintTop_toTopOf="parent">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/icCalendarIcon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:cardBackgroundColor="#1A2DCC70"
                        app:cardCornerRadius="@dimen/_78sdp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/txtSelectedMonth"
                        app:layout_constraintHorizontal_chainStyle="packed"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:strokeWidth="0dp">

                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="@dimen/_24sdp"
                            android:layout_height="@dimen/_24sdp"
                            android:padding="@dimen/_5sdp"
                            android:src="@drawable/ic_calendar"
                            app:tint="@color/primaryColor" />

                    </com.google.android.material.card.MaterialCardView>

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/txtSelectedMonth"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_8sdp"
                        android:ellipsize="end"
                        android:fontFamily="@font/bold"
                        android:maxLines="1"
                        android:text="@string/date"
                        android:textAlignment="viewStart"
                        android:textColor="@color/primaryColor"
                        android:textSize="@dimen/_13ssp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/icCalendarIcon"
                        app:layout_constraintTop_toTopOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnNextMonth"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:elevation="0dp"
                    app:cardBackgroundColor="@color/bgColorCard"
                    app:cardCornerRadius="@dimen/_57ssp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/cardMonthSelector"
                    app:layout_constraintTop_toTopOf="parent"
                    app:rippleColor="@android:color/transparent"
                    app:shapeAppearance="@style/ShapeAppearance.Material3.Corner.Full"
                    app:strokeColor="@color/divider_color"
                    app:strokeWidth="0.3dp">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="@dimen/_24sdp"
                        android:layout_height="@dimen/_24sdp"
                        android:padding="@dimen/_4sdp"
                        android:rotation="180"
                        android:src="@drawable/ic_left"
                        app:tint="@color/primaryColor" />

                </com.google.android.material.card.MaterialCardView>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- ATM Card Balance Section -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardBalance"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginHorizontal="@dimen/_14sdp"
                android:layout_marginTop="@dimen/_10sdp"
                android:clipToPadding="false"
                app:cardCornerRadius="@dimen/_14sdp"
                app:cardElevation="@dimen/_4sdp"
                app:layout_constraintDimensionRatio="H,1.68:1"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/layoutMonthSelector"
                app:strokeColor="#33FFFFFF"
                app:strokeWidth="1dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/card_bg" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_glass_sheen" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="@dimen/_14sdp">

                    <!-- Top Row: Wallet Icon + Balance Label + Visibility + More -->
                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/imgWallet"
                        android:layout_width="@dimen/_18sdp"
                        android:layout_height="@dimen/_18sdp"
                        android:src="@drawable/ic_wallet"
                        app:layout_constraintBottom_toBottomOf="@id/txtBalanceLabel"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="@id/txtBalanceLabel"
                        app:tint="#D0D8E0" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/txtBalanceLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_6sdp"
                        android:fontFamily="@font/bold"
                        android:letterSpacing="0.08"
                        android:text="@string/total_balance"
                        android:textAllCaps="true"
                        android:textColor="#D0D8E0"
                        android:textSize="@dimen/_10ssp"
                        app:layout_constraintStart_toEndOf="@id/imgWallet"
                        app:layout_constraintTop_toTopOf="parent" />

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/ivVisibility"
                        android:layout_width="@dimen/_18sdp"
                        android:layout_height="@dimen/_18sdp"
                        android:layout_marginStart="@dimen/_6sdp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="@dimen/_2sdp"
                        android:src="@drawable/ic_visibility"
                        app:layout_constraintBottom_toBottomOf="@id/txtBalanceLabel"
                        app:layout_constraintStart_toEndOf="@id/txtBalanceLabel"
                        app:layout_constraintTop_toTopOf="@id/txtBalanceLabel"
                        app:tint="#D0D8E0" />

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/ivMore"
                        android:layout_width="@dimen/_20sdp"
                        android:layout_height="@dimen/_20sdp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:padding="@dimen/_3sdp"
                        android:src="@drawable/ic_more"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:tint="#D0D8E0" />

                    <!-- Middle Section: Balance Amount directly below Wallet Icon -->
                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/txtBalanceValue"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_6sdp"
                        android:ellipsize="end"
                        android:fontFamily="@font/bold"
                        android:maxLines="1"
                        android:shadowColor="#99000000"
                        android:shadowDx="1.0"
                        android:shadowDy="2.0"
                        android:shadowRadius="3.0"
                        android:text="@string/amount"
                        android:textAlignment="viewStart"
                        android:textColor="#FFFFFF"
                        android:textDirection="ltr"
                        android:textSize="@dimen/_25ssp"
                        app:autoSizeMaxTextSize="@dimen/_25ssp"
                        app:autoSizeMinTextSize="@dimen/_14ssp"
                        app:autoSizeStepGranularity="1sp"
                        app:autoSizeTextType="uniform"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/imgWallet" />

                    <!-- Bottom Section: Cardholder Name + Account/Card Number + Payment Network Logo -->
                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/txtCardHolderName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/_2sdp"
                        android:fontFamily="@font/medium"
                        android:letterSpacing="0.08"
                        android:shadowColor="#A6000000"
                        android:shadowDx="0.0"
                        android:shadowDy="-1.0"
                        android:shadowRadius="1.0"
                        android:text="@string/text_card_holder"
                        android:textAllCaps="true"
                        android:textColor="#D0D8E0"
                        android:textSize="@dimen/_10ssp"
                        app:layout_constraintBottom_toTopOf="@id/txtAccountNumber"
                        app:layout_constraintStart_toStartOf="parent" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/txtAccountNumber"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/semi_bold"
                        android:letterSpacing="0.15"
                        android:shadowColor="#A6000000"
                        android:shadowDx="0.0"
                        android:shadowDy="-1.0"
                        android:shadowRadius="1.0"
                        android:text="@string/default_card_number"
                        android:textColor="#E0E6ED"
                        android:textSize="@dimen/_13ssp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/ivRupay"
                        android:layout_width="@dimen/_32sdp"
                        android:layout_height="@dimen/_20sdp"
                        android:src="@drawable/ic_round_rupay"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Income & Expense Summary Cards -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardIncome"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_14sdp"
                android:layout_marginTop="@dimen/_12sdp"
                android:layout_marginEnd="@dimen/_4sdp"
                app:cardBackgroundColor="@color/bgColorCard"
                app:cardCornerRadius="@dimen/_12sdp"
                app:cardElevation="0dp"
                app:layout_constraintEnd_toStartOf="@+id/cardExpense"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cardBalance"
                app:strokeColor="@color/divider_color"
                app:strokeWidth="0.8dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layoutDirection="ltr"
                    android:paddingHorizontal="@dimen/_10sdp"
                    android:paddingVertical="@dimen/_10sdp">

                    <View
                        android:id="@+id/icIncomeBg"
                        android:layout_width="@dimen/_24sdp"
                        android:layout_height="@dimen/_24sdp"
                        android:background="@drawable/bg_circle"
                        android:backgroundTint="@color/income_green_bg"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <com.google.android.material.imageview.ShapeableImageView
                        android:layout_width="@dimen/_14sdp"
                        android:layout_height="@dimen/_14sdp"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_arrow_up"
                        app:layout_constraintBottom_toBottomOf="@id/icIncomeBg"
                        app:layout_constraintEnd_toEndOf="@id/icIncomeBg"
                        app:layout_constraintStart_toStartOf="@id/icIncomeBg"
                        app:layout_constraintTop_toTopOf="@id/icIncomeBg"
                        app:tint="@color/income_green" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/txtIncomeLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_6sdp"
                        android:fontFamily="@font/semi_bold"
                        android:letterSpacing="0.03"
                        android:text="@string/income"
                        android:textAlignment="viewStart"
                        android:textAllCaps="true"
                        android:textColor="@color/TextColor"
                        android:textSize="@dimen/_10ssp"
                        app:layout_constraintBottom_toBottomOf="@id/icIncomeBg"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/icIncomeBg"
                        app:layout_constraintTop_toTopOf="@id/icIncomeBg" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/txtIncomeValue"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_8sdp"
                        android:ellipsize="end"
                        android:fontFamily="@font/bold"
                        android:maxLines="1"
                        android:paddingHorizontal="@dimen/_2sdp"
                        android:text="@string/amount"
                        android:textColor="@color/income_green"
                        android:textDirection="ltr"
                        android:textSize="@dimen/_13ssp"
                        app:autoSizeMaxTextSize="@dimen/_13ssp"
                        app:autoSizeMinTextSize="@dimen/_9ssp"
                        app:autoSizeStepGranularity="1sp"
                        app:autoSizeTextType="uniform"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="@+id/icIncomeBg"
                        app:layout_constraintTop_toBottomOf="@+id/icIncomeBg" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardExpense"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_4sdp"
                android:layout_marginTop="@dimen/_12sdp"
                android:layout_marginEnd="@dimen/_14sdp"
                app:cardBackgroundColor="@color/bgColorCard"
                app:cardCornerRadius="@dimen/_12sdp"
                app:cardElevation="0dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/cardIncome"
                app:layout_constraintTop_toBottomOf="@id/cardBalance"
                app:strokeColor="@color/divider_color"
                app:strokeWidth="0.8dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layoutDirection="ltr"
                    android:paddingHorizontal="@dimen/_10sdp"
                    android:paddingVertical="@dimen/_10sdp">

                    <View
                        android:id="@+id/icExpenseBg"
                        android:layout_width="@dimen/_24sdp"
                        android:layout_height="@dimen/_24sdp"
                        android:background="@drawable/bg_circle"
                        android:backgroundTint="@color/expense_red_bg"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <com.google.android.material.imageview.ShapeableImageView
                        android:layout_width="@dimen/_14sdp"
                        android:layout_height="@dimen/_14sdp"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_arrow_down"
                        app:layout_constraintBottom_toBottomOf="@id/icExpenseBg"
                        app:layout_constraintEnd_toEndOf="@id/icExpenseBg"
                        app:layout_constraintStart_toStartOf="@id/icExpenseBg"
                        app:layout_constraintTop_toTopOf="@id/icExpenseBg"
                        app:tint="@color/expense_red" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/txtExpenseLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_6sdp"
                        android:fontFamily="@font/semi_bold"
                        android:letterSpacing="0.05"
                        android:text="@string/expense"
                        android:textAlignment="viewStart"
                        android:textAllCaps="true"
                        android:textColor="@color/TextColor"
                        android:textSize="@dimen/_10ssp"
                        app:layout_constraintBottom_toBottomOf="@id/icExpenseBg"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/icExpenseBg"
                        app:layout_constraintTop_toTopOf="@id/icExpenseBg" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/txtExpenseValue"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_8sdp"
                        android:ellipsize="end"
                        android:fontFamily="@font/bold"
                        android:maxLines="1"
                        android:paddingHorizontal="@dimen/_2sdp"
                        android:text="@string/amount"
                        android:textColor="@color/expense_red"
                        android:textDirection="ltr"
                        android:textSize="@dimen/_13ssp"
                        app:autoSizeMaxTextSize="@dimen/_13ssp"
                        app:autoSizeMinTextSize="@dimen/_9ssp"
                        app:autoSizeStepGranularity="1sp"
                        app:autoSizeTextType="uniform"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="@+id/icExpenseBg"
                        app:layout_constraintTop_toBottomOf="@+id/icExpenseBg" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Recent Transactions Section -->
            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/txtRecent"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_14sdp"
                android:layout_marginTop="@dimen/_16sdp"
                android:layout_marginEnd="@dimen/_5sdp"
                android:ellipsize="end"
                android:fontFamily="@font/bold"
                android:maxLines="1"
                android:text="@string/recent_transactions"
                android:textAlignment="viewStart"
                android:textColor="@color/TextColor"
                android:textSize="@dimen/_14ssp"
                app:layout_constraintEnd_toStartOf="@+id/btnViewAll"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cardIncome"
                tools:visibility="gone" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnViewAll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_5sdp"
                android:layout_marginEnd="@dimen/_14sdp"
                app:cardBackgroundColor="@android:color/transparent"
                app:layout_constraintBottom_toBottomOf="@id/txtRecent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/txtRecent"
                app:layout_constraintTop_toTopOf="@id/txtRecent"
                app:shapeAppearance="@style/ShapeAppearance.Material3.Corner.Full"
                app:strokeWidth="0dp"
                tools:visibility="gone">

                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/semi_bold"
                    android:paddingHorizontal="@dimen/_6sdp"
                    android:paddingVertical="@dimen/_4sdp"
                    android:text="@string/view_all"
                    android:textColor="@color/primaryColor"
                    android:textSize="@dimen/_11ssp" />

            </com.google.android.material.card.MaterialCardView>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvTransactions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_8sdp"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                android:paddingHorizontal="@dimen/_14sdp"
                android:paddingBottom="@dimen/_70sdp"
                android:scrollbars="none"
                android:visibility="visible"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/txtRecent"
                app:layout_constraintVertical_bias="0"
                tools:itemCount="4"
                tools:listitem="@layout/item_transaction"
                tools:visibility="gone" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/clNoData"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_20sdp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/txtRecent"
                app:layout_constraintVertical_chainStyle="packed">

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tvNoData"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/_20sdp"
                    android:layout_marginBottom="@dimen/_8sdp"
                    android:fontFamily="@font/bold"
                    android:gravity="center"
                    android:text="@string/no_transactions_yet"
                    android:textColor="@color/TextColor"
                    android:textSize="@dimen/_15ssp"
                    android:visibility="visible"
                    app:layout_constraintBottom_toTopOf="@+id/tvNoDataDes"
                    app:layout_constraintTop_toTopOf="parent" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tvNoDataDes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/_20sdp"
                    android:layout_marginTop="@dimen/_4sdp"
                    android:layout_marginBottom="@dimen/_12sdp"
                    android:fontFamily="@font/regular"
                    android:gravity="center"
                    android:text="@string/start_tracking_your_income_and_nexpenses_to_see_insights_here"
                    android:textColor="@color/subTextColor"
                    android:textSize="@dimen/_11ssp"
                    android:visibility="visible"
                    app:layout_constraintTop_toBottomOf="@+id/tvNoData" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnAddExpanse"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_14sdp"
                    app:cardBackgroundColor="@color/primaryColor"
                    app:cardCornerRadius="@dimen/_10sdp"
                    app:cardElevation="0dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tvNoDataDes">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="@dimen/_14sdp"
                        android:paddingVertical="@dimen/_8sdp">

                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/ivAddTransaction"
                            android:layout_width="@dimen/_18sdp"
                            android:layout_height="@dimen/_18sdp"
                            android:src="@drawable/ic_plus"
                            android:tint="@android:color/white"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toStartOf="@+id/tvAddTransaction"
                            app:layout_constraintHorizontal_chainStyle="packed"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/tvAddTransaction"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/_6sdp"
                            android:fontFamily="@font/semi_bold"
                            android:gravity="center"
                            android:includeFontPadding="false"
                            android:text="@string/add_first_transaction"
                            android:textColor="@android:color/white"
                            android:textSize="@dimen/_13ssp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toEndOf="@+id/ivAddTransaction"
                            app:layout_constraintTop_toTopOf="parent" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                </com.google.android.material.card.MaterialCardView>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAdd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="@dimen/_12sdp"
        android:clipToOutline="true"
        android:outlineSpotShadowColor="@color/primaryColor"
        android:src="@android:drawable/ic_input_add"
        android:visibility="gone"
        app:backgroundTint="@color/primaryColor"
        app:elevation="@dimen/_6sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="1"
        app:tint="@android:color/white"
        app:useCompatPadding="true" />

</androidx.constraintlayout.widget.ConstraintLayout>
