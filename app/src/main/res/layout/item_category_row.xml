<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/_4sdp"
    android:paddingVertical="@dimen/_6sdp">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/view_color_dot"
        android:layout_width="@dimen/_9sdp"
        android:layout_height="@dimen/_9sdp"
        android:background="@drawable/bg_button"
        app:layout_constraintBottom_toBottomOf="@+id/txt_category_name"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/txt_category_name" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/txt_category_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_9sdp"
        android:fontFamily="@font/medium"
        android:text="@string/cat_food"
        android:textColor="@color/TextColor"
        android:textSize="@dimen/_11ssp"
        app:layout_constraintEnd_toStartOf="@+id/txt_category_amount"
        app:layout_constraintStart_toEndOf="@id/view_color_dot"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/txt_category_amount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/_7sdp"
        android:fontFamily="@font/bold"
        android:text="@string/amount"
        android:textColor="@color/TextColor"
        android:textSize="@dimen/_11ssp"
        app:layout_constraintBottom_toBottomOf="@+id/txt_category_name"
        app:layout_constraintEnd_toStartOf="@+id/txt_category_percent"
        app:layout_constraintTop_toTopOf="@+id/txt_category_name" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/txt_category_percent"
        android:layout_width="@dimen/_29sdp"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:text="@string/text_not_applicable"
        android:textColor="@color/subTextColor"
        android:textSize="@dimen/_10ssp"
        app:layout_constraintBottom_toBottomOf="@+id/txt_category_name"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/txt_category_name" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progress_category"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_6sdp"
        android:max="100"
        android:progress="35"
        app:indicatorTrackGapSize="0dp"
        app:trackStopIndicatorSize="0dp"
        app:trackColor="@color/divider_color"
        app:indicatorColor="@color/primaryColor"
        app:layout_constraintTop_toBottomOf="@id/txt_category_name" />

</androidx.constraintlayout.widget.ConstraintLayout>
