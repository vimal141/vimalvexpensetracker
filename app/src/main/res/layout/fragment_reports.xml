<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bgColor">

    <ScrollView
        android:id="@+id/scroll_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bgColor"
        android:fillViewport="true"
        android:scrollbars="none">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="@dimen/_70sdp">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/fragmentTittle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/bold"
                android:maxLines="1"
                android:paddingHorizontal="@dimen/_14sdp"
                android:paddingVertical="@dimen/_12sdp"
                android:text="@string/reports"
                android:textAlignment="viewStart"
                android:textColor="@color/TextColor"
                android:textSize="@dimen/_22ssp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layout_month_selector"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_14sdp"
                android:layout_marginTop="@dimen/_4sdp"
                android:background="@android:color/transparent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/fragmentTittle">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btn_prev_month"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:elevation="0dp"
                    app:cardBackgroundColor="@color/bgColorCard"
                    app:cardCornerRadius="@dimen/_57ssp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/card_month_selector"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:rippleColor="@android:color/transparent"
                    app:shapeAppearance="@style/ShapeAppearance.Material3.Corner.Full"
                    app:strokeColor="@color/divider_color"
                    app:strokeWidth="0.3dp">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="@dimen/_24sdp"
                        android:layout_height="@dimen/_24sdp"
                        android:padding="@dimen/_4sdp"
                        android:src="@drawable/ic_left"
                        app:tint="@color/primaryColor" />

                </com.google.android.material.card.MaterialCardView>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/card_month_selector"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:paddingVertical="@dimen/_4sdp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/btn_next_month"
                    app:layout_constraintStart_toEndOf="@id/btn_prev_month"
                    app:layout_constraintTop_toTopOf="parent">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/ic_calendar_icon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:cardBackgroundColor="#1A2DCC70"
                        app:cardCornerRadius="@dimen/_101sdp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/txt_selected_month"
                        app:layout_constraintHorizontal_chainStyle="packed"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:strokeWidth="0dp">

                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="@dimen/_24sdp"
                            android:layout_height="@dimen/_24sdp"
                            android:padding="@dimen/_5sdp"
                            android:src="@drawable/ic_calendar"
                            app:tint="@color/primaryColor" />

                    </com.google.android.material.card.MaterialCardView>

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/txt_selected_month"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_8sdp"
                        android:ellipsize="end"
                        android:fontFamily="@font/bold"
                        android:maxLines="1"
                        android:text="@string/date"
                        android:textAlignment="viewStart"
                        android:textColor="@color/primaryColor"
                        android:textSize="@dimen/_14ssp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/ic_calendar_icon"
                        app:layout_constraintTop_toTopOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btn_next_month"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:elevation="0dp"
                    app:cardBackgroundColor="@color/bgColorCard"
                    app:cardCornerRadius="@dimen/_57ssp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/card_month_selector"
                    app:layout_constraintTop_toTopOf="parent"
                    app:rippleColor="@android:color/transparent"
                    app:shapeAppearance="@style/ShapeAppearance.Material3.Corner.Full"
                    app:strokeColor="@color/divider_color"
                    app:strokeWidth="0.3dp">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="@dimen/_24sdp"
                        android:layout_height="@dimen/_24sdp"
                        android:padding="@dimen/_4sdp"
                        android:rotation="180"
                        android:src="@drawable/ic_left"
                        app:tint="@color/primaryColor" />

                </com.google.android.material.card.MaterialCardView>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_tabs"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_34sdp"
                android:layout_marginHorizontal="@dimen/_14sdp"
                android:layout_marginTop="@dimen/_10sdp"
                app:cardBackgroundColor="@color/bgColorCard"
                app:cardCornerRadius="@dimen/_10sdp"
                app:cardElevation="0dp"
                app:layout_constraintTop_toBottomOf="@id/layout_month_selector"
                app:strokeColor="@color/divider_color"
                app:strokeWidth="0.8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:padding="@dimen/_3sdp">

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/tab_daily"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:fontFamily="@font/semi_bold"
                        android:gravity="center"
                        android:text="@string/daily"
                        android:textColor="@color/subTextColor"
                        android:textSize="@dimen/_11ssp" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/tab_weekly"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:fontFamily="@font/semi_bold"
                        android:gravity="center"
                        android:text="@string/weekly"
                        android:textColor="@color/subTextColor"
                        android:textSize="@dimen/_11ssp" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/tab_monthly"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/bg_tab"
                        android:fontFamily="@font/semi_bold"
                        android:gravity="center"
                        android:text="@string/monthly"
                        android:textColor="@android:color/white"
                        android:textSize="@dimen/_11ssp" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/tab_yearly"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:fontFamily="@font/semi_bold"
                        android:gravity="center"
                        android:text="@string/yearly"
                        android:textColor="@color/subTextColor"
                        android:textSize="@dimen/_11ssp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layout_summaries"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_12sdp"
                app:layout_constraintTop_toBottomOf="@id/card_tabs">

                <!-- Income -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_income"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_14sdp"
                    android:layout_marginEnd="@dimen/_4sdp"
                    app:cardBackgroundColor="@color/bgColorCard"
                    app:cardCornerRadius="@dimen/_12sdp"
                    app:cardElevation="0dp"
                    app:layout_constraintEnd_toStartOf="@+id/card_expense"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:strokeColor="@color/divider_color"
                    app:strokeWidth="0.8dp">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="@dimen/_12sdp"
                        android:paddingVertical="@dimen/_10sdp">

                        <View
                            android:id="@+id/ic_income_bg"
                            android:layout_width="@dimen/_28sdp"
                            android:layout_height="@dimen/_28sdp"
                            android:background="@drawable/bg_circle"
                            android:backgroundTint="@color/income_green_bg"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <com.google.android.material.imageview.ShapeableImageView
                            android:layout_width="@dimen/_16sdp"
                            android:layout_height="@dimen/_16sdp"
                            android:scaleType="centerInside"
                            android:src="@drawable/ic_arrow_up"
                            app:layout_constraintBottom_toBottomOf="@id/ic_income_bg"
                            app:layout_constraintEnd_toEndOf="@id/ic_income_bg"
                            app:layout_constraintStart_toStartOf="@id/ic_income_bg"
                            app:layout_constraintTop_toTopOf="@id/ic_income_bg"
                            app:tint="@color/income_green" />

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/lbl_income"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/_8sdp"
                            android:fontFamily="@font/semi_bold"
                            android:letterSpacing="0.05"
                            android:text="@string/income"
                            android:textAllCaps="true"
                            android:textColor="@color/TextColor"
                            android:textSize="@dimen/_11ssp"
                            app:layout_constraintBottom_toBottomOf="@id/ic_income_bg"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toEndOf="@id/ic_income_bg"
                            app:layout_constraintTop_toTopOf="@id/ic_income_bg" />

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/txt_report_income"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_8sdp"
                            android:ellipsize="end"
                            android:fontFamily="@font/bold"
                            android:maxLines="1"
                            android:paddingHorizontal="@dimen/_2sdp"
                            android:text="@string/amount"
                            android:textColor="@color/income_green"
                            android:textSize="@dimen/_15ssp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="@+id/lbl_income"
                            app:layout_constraintStart_toStartOf="@+id/ic_income_bg"
                            app:layout_constraintTop_toBottomOf="@+id/ic_income_bg" />

                    </androidx.constraintlayout.widget.ConstraintLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Expense -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_expense"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_4sdp"
                    android:layout_marginEnd="@dimen/_14sdp"
                    app:cardBackgroundColor="@color/bgColorCard"
                    app:cardCornerRadius="@dimen/_12sdp"
                    app:cardElevation="0dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/card_income"
                    app:layout_constraintTop_toTopOf="parent"
                    app:strokeColor="@color/divider_color"
                    app:strokeWidth="0.8dp">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="@dimen/_12sdp"
                        android:paddingVertical="@dimen/_10sdp">

                        <View
                            android:id="@+id/ic_expense_bg"
                            android:layout_width="@dimen/_28sdp"
                            android:layout_height="@dimen/_28sdp"
                            android:background="@drawable/bg_circle"
                            android:backgroundTint="@color/expense_red_bg"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <com.google.android.material.imageview.ShapeableImageView
                            android:layout_width="@dimen/_16sdp"
                            android:layout_height="@dimen/_16sdp"
                            android:scaleType="centerInside"
                            android:src="@drawable/ic_arrow_down"
                            app:layout_constraintBottom_toBottomOf="@id/ic_expense_bg"
                            app:layout_constraintEnd_toEndOf="@id/ic_expense_bg"
                            app:layout_constraintStart_toStartOf="@id/ic_expense_bg"
                            app:layout_constraintTop_toTopOf="@id/ic_expense_bg"
                            app:tint="@color/expense_red" />

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/lbl_expense"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/_8sdp"
                            android:fontFamily="@font/semi_bold"
                            android:letterSpacing="0.05"
                            android:text="@string/expense"
                            android:textAllCaps="true"
                            android:textColor="@color/TextColor"
                            android:textSize="@dimen/_11ssp"
                            app:layout_constraintBottom_toBottomOf="@id/ic_expense_bg"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toEndOf="@id/ic_expense_bg"
                            app:layout_constraintTop_toTopOf="@id/ic_expense_bg" />

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/txt_report_expense"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_8sdp"
                            android:ellipsize="end"
                            android:fontFamily="@font/bold"
                            android:maxLines="1"
                            android:paddingHorizontal="@dimen/_2sdp"
                            android:text="@string/amount"
                            android:textColor="@color/expense_red"
                            android:textSize="@dimen/_15ssp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="@+id/lbl_expense"
                            app:layout_constraintStart_toStartOf="@+id/ic_expense_bg"
                            app:layout_constraintTop_toBottomOf="@+id/ic_expense_bg" />

                    </androidx.constraintlayout.widget.ConstraintLayout>
                </com.google.android.material.card.MaterialCardView>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_pie"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_14sdp"
                android:layout_marginTop="@dimen/_12sdp"
                app:cardBackgroundColor="@color/bgColorCard"
                app:cardCornerRadius="@dimen/_13sdp"
                app:cardElevation="0dp"
                app:layout_constraintTop_toBottomOf="@id/layout_summaries"
                app:strokeColor="@color/divider_color"
                app:strokeWidth="0.8dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/_14sdp">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/txt_pie_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="@font/bold"
                        android:maxLines="1"
                        android:text="@string/financial_analysis"
                        android:textColor="@color/TextColor"
                        android:textSize="@dimen/_15ssp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/card_type_tabs"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_34sdp"
                        android:layout_marginTop="@dimen/_10sdp"
                        app:cardBackgroundColor="@color/bgColor"
                        app:cardCornerRadius="@dimen/_10sdp"
                        app:cardElevation="0dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/txt_pie_title"
                        app:strokeColor="@color/divider_color"
                        app:strokeWidth="0.8dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="horizontal"
                            android:padding="@dimen/_3sdp">

                            <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/tab_report_expense"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:background="@drawable/bg_tab"
                                android:fontFamily="@font/semi_bold"
                                android:gravity="center"
                                android:text="@string/expense"
                                android:textColor="@android:color/white"
                                android:textSize="@dimen/_11ssp" />

                            <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/tab_report_income"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:fontFamily="@font/semi_bold"
                                android:gravity="center"
                                android:text="@string/income"
                                android:textColor="@color/subTextColor"
                                android:textSize="@dimen/_11ssp" />

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                    <com.tb.example.expensebook.utility.customview.PieChartView
                        android:id="@+id/pie_chart_view"
                        android:layout_width="@dimen/_180sdp"
                        android:layout_height="@dimen/_180sdp"
                        android:layout_marginTop="@dimen/_14sdp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/card_type_tabs" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_category"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_14sdp"
                android:layout_marginTop="@dimen/_12sdp"
                app:cardBackgroundColor="@color/bgColorCard"
                app:cardCornerRadius="@dimen/_13sdp"
                app:cardElevation="0dp"
                app:layout_constraintTop_toBottomOf="@id/card_pie"
                app:strokeColor="@color/divider_color"
                app:strokeWidth="0.8dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/_14sdp">

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/txt_cat_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/_10sdp"
                        android:fontFamily="@font/bold"
                        android:text="@string/category_breakdown"
                        android:textColor="@color/TextColor"
                        android:textSize="@dimen/_16ssp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <LinearLayout
                        android:id="@+id/layout_categories"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_10sdp"
                        android:orientation="vertical"
                        app:layout_constraintTop_toBottomOf="@id/txt_cat_title" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Native Ad Container -->
            <FrameLayout
                android:id="@+id/fl_native_ad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_12sdp"
                android:paddingBottom="@dimen/_70sdp"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@id/card_category" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
