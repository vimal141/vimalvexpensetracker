<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bgColor">

    <ScrollView
        android:id="@+id/scrollContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bgColor"
        android:fillViewport="true"
        android:scrollbars="none">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="@dimen/_70sdp">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/fragmentTittle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/bold"
                android:maxLines="1"
                android:paddingHorizontal="@dimen/_14sdp"
                android:paddingVertical="@dimen/_12sdp"
                android:text="@string/reports"
                android:textAlignment="viewStart"
                android:textColor="@color/TextColor"
                android:textSize="@dimen/_22ssp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layoutMonthSelector"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_14sdp"
                android:layout_marginTop="@dimen/_4sdp"
                android:background="@android:color/transparent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/fragmentTittle">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnPrevMonth"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:elevation="0dp"
                    app:cardBackgroundColor="@color/bgColorCard"
                    app:cardCornerRadius="@dimen/_57ssp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/cardMonthSelector"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:rippleColor="@android:color/transparent"
                    app:shapeAppearance="@style/ShapeAppearance.Material3.Corner.Full"
                    app:strokeColor="@color/divider_color"
                    app:strokeWidth="0.3dp">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="@dimen/_24sdp"
                        android:layout_height="@dimen/_24sdp"
                        android:padding="@dimen/_4sdp"
                        android:src="@drawable/ic_left"
                        app:tint="@color/primaryColor" />

                </com.google.android.material.card.MaterialCardView>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cardMonthSelector"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:paddingVertical="@dimen/_4sdp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/btnNextMonth"
                    app:layout_constraintStart_toEndOf="@id/btnPrevMonth"
                    app:layout_constraintTop_toTopOf="parent">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/icCalendarIcon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:cardBackgroundColor="#1A2DCC70"
                        app:cardCornerRadius="@dimen/_101sdp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/txtSelectedMonth"
                        app:layout_constraintHorizontal_chainStyle="packed"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:strokeWidth="0dp">

                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="@dimen/_24sdp"
                            android:layout_height="@dimen/_24sdp"
                            android:padding="@dimen/_5sdp"
                            android:src="@drawable/ic_calendar"
                            app:tint="@color/primaryColor" />

                    </com.google.android.material.card.MaterialCardView>

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/txtSelectedMonth"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_8sdp"
                        android:ellipsize="end"
                        android:fontFamily="@font/bold"
                        android:maxLines="1"
                        android:text="@string/date"
                        android:textAlignment="viewStart"
                        android:textColor="@color/primaryColor"
                        android:textSize="@dimen/_14ssp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/icCalendarIcon"
                        app:layout_constraintTop_toTopOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnNextMonth"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:elevation="0dp"
                    app:cardBackgroundColor="@color/bgColorCard"
                    app:cardCornerRadius="@dimen/_57ssp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/cardMonthSelector"
                    app:layout_constraintTop_toTopOf="parent"
                    app:rippleColor="@android:color/transparent"
                    app:shapeAppearance="@style/ShapeAppearance.Material3.Corner.Full"
                    app:strokeColor="@color/divider_color"
                    app:strokeWidth="0.3dp">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="@dimen/_24sdp"
                        android:layout_height="@dimen/_24sdp"
                        android:padding="@dimen/_4sdp"
                        android:rotation="180"
                        android:src="@drawable/ic_left"
                        app:tint="@color/primaryColor" />

                </com.google.android.material.card.MaterialCardView>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardTabs"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_34sdp"
                android:layout_marginHorizontal="@dimen/_14sdp"
                android:layout_marginTop="@dimen/_10sdp"
                app:cardBackgroundColor="@color/bgColorCard"
                app:cardCornerRadius="@dimen/_10sdp"
                app:cardElevation="0dp"
                app:layout_constraintTop_toBottomOf="@id/layoutMonthSelector"
                app:strokeColor="@color/divider_color"
                app:strokeWidth="0.8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:padding="@dimen/_3sdp">

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/tabDaily"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:fontFamily="@font/semi_bold"
                        android:gravity="center"
                        android:text="@string/daily"
                        android:textColor="@color/subTextColor"
                        android:textSize="@dimen/_11ssp" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/tabWeekly"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:fontFamily="@font/semi_bold"
                        android:gravity="center"
                        android:text="@string/weekly"
                        android:textColor="@color/subTextColor"
                        android:textSize="@dimen/_11ssp" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/tabMonthly"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/bg_tab"
                        android:fontFamily="@font/semi_bold"
                        android:gravity="center"
                        android:text="@string/monthly"
                        android:textColor="@android:color/white"
                        android:textSize="@dimen/_11ssp" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/tabYearly"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:fontFamily="@font/semi_bold"
                        android:gravity="center"
                        android:text="@string/yearly"
                        android:textColor="@color/subTextColor"
                        android:textSize="@dimen/_11ssp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layoutSummaries"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_12sdp"
                app:layout_constraintTop_toBottomOf="@id/cardTabs">

                <!-- Income -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardIncome"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_14sdp"
                    android:layout_marginEnd="@dimen/_4sdp"
                    app:cardBackgroundColor="@color/bgColorCard"
                    app:cardCornerRadius="@dimen/_12sdp"
                    app:cardElevation="0dp"
                    app:layout_constraintEnd_toStartOf="@+id/cardExpense"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:strokeColor="@color/divider_color"
                    app:strokeWidth="0.8dp">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layoutDirection="ltr"
                        android:paddingHorizontal="@dimen/_12sdp"
                        android:paddingVertical="@dimen/_10sdp">

                        <View
                            android:id="@+id/icIncomeBg"
                            android:layout_width="@dimen/_28sdp"
                            android:layout_height="@dimen/_28sdp"
                            android:background="@drawable/bg_circle"
                            android:backgroundTint="@color/income_green_bg"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <com.google.android.material.imageview.ShapeableImageView
                            android:layout_width="@dimen/_16sdp"
                            android:layout_height="@dimen/_16sdp"
                            android:scaleType="centerInside"
                            android:src="@drawable/ic_arrow_up"
                            app:layout_constraintBottom_toBottomOf="@id/icIncomeBg"
                            app:layout_constraintEnd_toEndOf="@id/icIncomeBg"
                            app:layout_constraintStart_toStartOf="@id/icIncomeBg"
                            app:layout_constraintTop_toTopOf="@id/icIncomeBg"
                            app:tint="@color/income_green" />

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/lblIncome"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/_6sdp"
                            android:ellipsize="end"
                            android:fontFamily="@font/semi_bold"
                            android:gravity="start|center_vertical"
                            android:letterSpacing="0.05"
                            android:maxLines="1"
                            android:text="@string/income"
                            android:textAlignment="viewStart"
                            android:textAllCaps="true"
                            android:textColor="@color/TextColor"
                            android:textSize="@dimen/_11ssp"
                            app:layout_constraintBottom_toBottomOf="@id/icIncomeBg"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toEndOf="@id/icIncomeBg"
                            app:layout_constraintTop_toTopOf="@id/icIncomeBg" />

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/txtReportIncome"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_8sdp"
                            android:ellipsize="end"
                            android:fontFamily="@font/bold"
                            android:maxLines="1"
                            android:paddingHorizontal="@dimen/_4sdp"
                            android:text="@string/amount"
                            android:textColor="@color/income_green"
                            android:textDirection="ltr"
                            android:textSize="@dimen/_15ssp"
                            app:autoSizeMaxTextSize="@dimen/_15ssp"
                            app:autoSizeMinTextSize="@dimen/_10ssp"
                            app:autoSizeStepGranularity="1sp"
                            app:autoSizeTextType="uniform"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="@+id/lblIncome"
                            app:layout_constraintStart_toStartOf="@+id/icIncomeBg"
                            app:layout_constraintTop_toBottomOf="@+id/icIncomeBg" />

                    </androidx.constraintlayout.widget.ConstraintLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Expense -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardExpense"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_4sdp"
                    android:layout_marginEnd="@dimen/_14sdp"
                    app:cardBackgroundColor="@color/bgColorCard"
                    app:cardCornerRadius="@dimen/_12sdp"
                    app:cardElevation="0dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/cardIncome"
                    app:layout_constraintTop_toTopOf="parent"
                    app:strokeColor="@color/divider_color"
                    app:strokeWidth="0.8dp">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layoutDirection="ltr"
                        android:paddingHorizontal="@dimen/_12sdp"
                        android:paddingVertical="@dimen/_10sdp">

                        <View
                            android:id="@+id/icExpenseBg"
                            android:layout_width="@dimen/_28sdp"
                            android:layout_height="@dimen/_28sdp"
                            android:background="@drawable/bg_circle"
                            android:backgroundTint="@color/expense_red_bg"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <com.google.android.material.imageview.ShapeableImageView
                            android:layout_width="@dimen/_16sdp"
                            android:layout_height="@dimen/_16sdp"
                            android:scaleType="centerInside"
                            android:src="@drawable/ic_arrow_down"
                            app:layout_constraintBottom_toBottomOf="@id/icExpenseBg"
                            app:layout_constraintEnd_toEndOf="@id/icExpenseBg"
                            app:layout_constraintStart_toStartOf="@id/icExpenseBg"
                            app:layout_constraintTop_toTopOf="@id/icExpenseBg"
                            app:tint="@color/expense_red" />

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/lblExpense"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/_6sdp"
                            android:ellipsize="end"
                            android:fontFamily="@font/semi_bold"
                            android:gravity="start|center_vertical"
                            android:letterSpacing="0.05"
                            android:maxLines="1"
                            android:text="@string/expense"
                            android:textAlignment="viewStart"
                            android:textAllCaps="true"
                            android:textColor="@color/TextColor"
                            android:textSize="@dimen/_11ssp"
                            app:layout_constraintBottom_toBottomOf="@id/icExpenseBg"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toEndOf="@id/icExpenseBg"
                            app:layout_constraintTop_toTopOf="@id/icExpenseBg" />

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/txtReportExpense"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_8sdp"
                            android:ellipsize="end"
                            android:fontFamily="@font/bold"
                            android:maxLines="1"
                            android:paddingHorizontal="@dimen/_4sdp"
                            android:text="@string/amount"
                            android:textColor="@color/expense_red"
                            android:textDirection="ltr"
                            android:textSize="@dimen/_15ssp"
                            app:autoSizeMaxTextSize="@dimen/_15ssp"
                            app:autoSizeMinTextSize="@dimen/_10ssp"
                            app:autoSizeStepGranularity="1sp"
                            app:autoSizeTextType="uniform"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="@+id/lblExpense"
                            app:layout_constraintStart_toStartOf="@+id/icExpenseBg"
                            app:layout_constraintTop_toBottomOf="@+id/icExpenseBg" />

                    </androidx.constraintlayout.widget.ConstraintLayout>
                </com.google.android.material.card.MaterialCardView>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPie"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_14sdp"
                android:layout_marginTop="@dimen/_12sdp"
                app:cardBackgroundColor="@color/bgColorCard"
                app:cardCornerRadius="@dimen/_13sdp"
                app:cardElevation="0dp"
                app:layout_constraintTop_toBottomOf="@id/layoutSummaries"
                app:strokeColor="@color/divider_color"
                app:strokeWidth="0.8dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/_14sdp">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/txtPieTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="@font/bold"
                        android:maxLines="1"
                        android:text="@string/financial_analysis"
                        android:textColor="@color/TextColor"
                        android:textSize="@dimen/_15ssp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardTypeTabs"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_34sdp"
                        android:layout_marginTop="@dimen/_10sdp"
                        app:cardBackgroundColor="@color/bgColor"
                        app:cardCornerRadius="@dimen/_10sdp"
                        app:cardElevation="0dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/txtPieTitle"
                        app:strokeColor="@color/divider_color"
                        app:strokeWidth="0.8dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="horizontal"
                            android:padding="@dimen/_3sdp">

                            <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/tabReportExpense"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:background="@drawable/bg_tab"
                                android:fontFamily="@font/semi_bold"
                                android:gravity="center"
                                android:text="@string/expense"
                                android:textColor="@android:color/white"
                                android:textSize="@dimen/_11ssp" />

                            <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/tabReportIncome"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:fontFamily="@font/semi_bold"
                                android:gravity="center"
                                android:text="@string/income"
                                android:textColor="@color/subTextColor"
                                android:textSize="@dimen/_11ssp" />

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                    <cashvexa.expensetracker.budget.money.utility.customview.PieChartView
                        android:id="@+id/pieChartView"
                        android:layout_width="@dimen/_180sdp"
                        android:layout_height="@dimen/_180sdp"
                        android:layout_marginTop="@dimen/_14sdp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/cardTypeTabs" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardCategory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_14sdp"
                android:layout_marginTop="@dimen/_12sdp"
                app:cardBackgroundColor="@color/bgColorCard"
                app:cardCornerRadius="@dimen/_13sdp"
                app:cardElevation="0dp"
                app:layout_constraintTop_toBottomOf="@id/cardPie"
                app:strokeColor="@color/divider_color"
                app:strokeWidth="0.8dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/_14sdp">

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/txtCatTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/_10sdp"
                        android:fontFamily="@font/bold"
                        android:text="@string/category_breakdown"
                        android:textColor="@color/TextColor"
                        android:textSize="@dimen/_16ssp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <LinearLayout
                        android:id="@+id/layoutCategories"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_10sdp"
                        android:orientation="vertical"
                        app:layout_constraintTop_toBottomOf="@id/txtCatTitle" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
