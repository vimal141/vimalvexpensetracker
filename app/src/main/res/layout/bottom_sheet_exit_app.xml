<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:paddingHorizontal="@dimen/_14sdp"
    android:paddingTop="@dimen/_10sdp"
    android:paddingBottom="@dimen/_20sdp">

    <!-- Drag Handle -->
    <View
        android:id="@+id/dragHandle"
        android:layout_width="@dimen/_36sdp"
        android:layout_height="@dimen/_4sdp"
        android:background="@drawable/bg_button"
        android:backgroundTint="@color/divider_color"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Close/Exit Icon Container -->
    <FrameLayout
        android:id="@+id/icon_warning_container"
        android:layout_width="@dimen/_44sdp"
        android:layout_height="@dimen/_44sdp"
        android:layout_marginTop="@dimen/_14sdp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/dragHandle">

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_button"
            android:backgroundTint="#1AFF3B30" />

        <com.google.android.material.imageview.ShapeableImageView
            android:layout_width="@dimen/_22sdp"
            android:layout_height="@dimen/_22sdp"
            android:layout_gravity="center"
            android:scaleType="centerInside"
            android:src="@drawable/ic_close"
            app:tint="#FF3B30" />

    </FrameLayout>

    <!-- Title -->
    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/tvTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_12sdp"
        android:ellipsize="end"
        android:fontFamily="@font/bold"
        android:maxLines="1"
        android:text="@string/exit_dialog_title"
        android:textColor="@color/TextColor"
        android:textSize="@dimen/_17ssp"
        app:layout_constraintBottom_toTopOf="@+id/tvDescription"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/icon_warning_container"
        app:layout_constraintTop_toTopOf="@id/icon_warning_container"
        app:layout_constraintVertical_chainStyle="packed" />

    <!-- Subheader Section Label -->
    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/tvDescription"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_12sdp"
        android:layout_marginTop="@dimen/_3sdp"
        android:fontFamily="@font/medium"
        android:text="@string/exit_dialog_desc"
        android:textColor="@color/subTextColor"
        android:textSize="@dimen/_11ssp"
        app:layout_constraintBottom_toBottomOf="@id/icon_warning_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/icon_warning_container"
        app:layout_constraintTop_toBottomOf="@id/tvTitle" />

    <!-- Action Buttons Container -->
    <LinearLayout
        android:id="@+id/layout_buttons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_20sdp"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/icon_warning_container">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancel"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="@dimen/_44sdp"
            android:layout_marginEnd="@dimen/_6sdp"
            android:layout_weight="1"
            android:fontFamily="@font/semi_bold"
            android:text="@string/cancel"
            android:textAllCaps="false"
            android:textColor="@color/TextColor"
            android:textSize="@dimen/_13ssp"
            app:cornerRadius="@dimen/_12sdp"
            app:strokeColor="@color/divider_color"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnExit"
            android:layout_width="0dp"
            android:layout_height="@dimen/_44sdp"
            android:layout_marginStart="@dimen/_6sdp"
            android:layout_weight="1"
            android:fontFamily="@font/bold"
            android:text="@string/exit"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="@dimen/_13ssp"
            app:backgroundTint="#FF3B30"
            app:cornerRadius="@dimen/_12sdp"
            app:elevation="0dp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
