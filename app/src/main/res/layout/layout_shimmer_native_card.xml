<?xml version="1.0" encoding="utf-8"?>
<com.facebook.shimmer.ShimmerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/shimmer_view_native_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:shimmer_auto_start="true"
    app:shimmer_base_color="@color/shimmer_base_color"
    app:shimmer_highlight_color="@color/shimmer_highlight_color"
    app:shimmer_duration="1200">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/ad_card_bg"
        android:paddingHorizontal="@dimen/_14sdp"
        android:paddingVertical="@dimen/_8sdp">

        <!-- Ad Attribution Badge -->
        <View
            android:id="@+id/shim_ad_badge"
            android:layout_width="@dimen/_18sdp"
            android:layout_height="@dimen/_8sdp"
            android:background="@drawable/bg_shimmer_rect"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- App Icon -->
        <View
            android:id="@+id/shim_app_icon"
            android:layout_width="@dimen/_28sdp"
            android:layout_height="@dimen/_28sdp"
            android:layout_marginTop="@dimen/_4sdp"
            android:background="@drawable/bg_shimmer_rect"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/shim_ad_badge" />

        <!-- Headline -->
        <View
            android:id="@+id/shim_headline"
            android:layout_width="0dp"
            android:layout_height="@dimen/_10sdp"
            android:layout_marginStart="@dimen/_6sdp"
            android:layout_marginEnd="@dimen/_8sdp"
            android:background="@drawable/bg_shimmer_rect"
            app:layout_constraintEnd_toStartOf="@+id/shim_cta_btn"
            app:layout_constraintStart_toEndOf="@id/shim_app_icon"
            app:layout_constraintTop_toTopOf="@+id/shim_app_icon" />

        <!-- Subtitle/Advertiser -->
        <View
            android:id="@+id/shim_advertiser"
            android:layout_width="@dimen/_50sdp"
            android:layout_height="@dimen/_7sdp"
            android:layout_marginStart="@dimen/_6sdp"
            android:layout_marginTop="@dimen/_4sdp"
            android:background="@drawable/bg_shimmer_rect"
            app:layout_constraintStart_toEndOf="@+id/shim_app_icon"
            app:layout_constraintTop_toBottomOf="@+id/shim_headline" />

        <!-- CTA Button -->
        <View
            android:id="@+id/shim_cta_btn"
            android:layout_width="@dimen/_65sdp"
            android:layout_height="@dimen/_26sdp"
            android:background="@drawable/bg_shimmer_rect"
            app:layout_constraintBottom_toBottomOf="@+id/shim_app_icon"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/shim_app_icon" />

        <!-- Body Description -->
        <View
            android:id="@+id/shim_body"
            android:layout_width="0dp"
            android:layout_height="@dimen/_8sdp"
            android:layout_marginTop="@dimen/_5sdp"
            android:layout_marginEnd="@dimen/_20sdp"
            android:background="@drawable/bg_shimmer_rect"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/shim_app_icon" />

        <!-- Media View Shimmer -->
        <View
            android:id="@+id/shim_media"
            android:layout_width="0dp"
            android:layout_height="@dimen/_75sdp"
            android:layout_marginTop="@dimen/_5sdp"
            android:background="@drawable/bg_shimmer_rect"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/shim_body" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.facebook.shimmer.ShimmerFrameLayout>
