<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bgColor">

    <!-- Header / Toolbar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/_14sdp"
        android:paddingVertical="@dimen/_12sdp"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/btn_back"
            android:layout_width="@dimen/_31sdp"
            android:layout_height="@dimen/_31sdp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:padding="@dimen/_4sdp"
            android:src="@drawable/ic_back"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/TextColor" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/txt_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/semi_bold"
            android:maxLines="1"
            android:text="@string/about_app"
            android:textColor="@color/TextColor"
            android:textSize="@dimen/_18ssp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingHorizontal="@dimen/_14sdp"
        android:paddingBottom="@dimen/_20sdp"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layout_header">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- App Logo & Branding Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardBranding"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_10sdp"
                app:cardBackgroundColor="@color/bgColorCard"
                app:cardCornerRadius="@dimen/_16sdp"
                app:cardElevation="0dp"
                app:layout_constraintTop_toTopOf="parent"
                app:strokeColor="@color/divider_color"
                app:strokeWidth="0.8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/_16sdp"
                    android:paddingVertical="@dimen/_20sdp">

                    <!-- App Logo Frame -->
                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/imgAppLogo"
                        android:layout_width="@dimen/_76sdp"
                        android:layout_height="@dimen/_76sdp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/splash_logo" />

                    <!-- App Name -->
                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/txtAppName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_12sdp"
                        android:fontFamily="@font/bold"
                        android:text="@string/app_name"
                        android:textColor="@color/TextColor"
                        android:textSize="@dimen/_20ssp" />

                    <!-- App Version -->
                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/txtAppVersion"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_3sdp"
                        android:fontFamily="@font/medium"
                        android:text="@string/version_1_0_0"
                        android:textColor="@color/primaryColor"
                        android:textSize="@dimen/_12ssp" />

                    <!-- Tagline -->
                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_4sdp"
                        android:fontFamily="@font/medium"
                        android:text="Smart &amp; Simple Expense Tracker"
                        android:textColor="@color/subTextColor"
                        android:textSize="@dimen/_11ssp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Features Summary Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardFeatures"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_14sdp"
                app:cardBackgroundColor="@color/bgColorCard"
                app:cardCornerRadius="@dimen/_14sdp"
                app:cardElevation="0dp"
                app:layout_constraintTop_toBottomOf="@id/cardBranding"
                app:strokeColor="@color/divider_color"
                app:strokeWidth="0.8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/_14sdp"
                    android:paddingVertical="@dimen/_14sdp">

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/bold"
                        android:text="Key Features"
                        android:textColor="@color/TextColor"
                        android:textSize="@dimen/_13ssp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="0.8dp"
                        android:layout_marginVertical="@dimen/_8sdp"
                        android:background="@color/divider_color" />

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/medium"
                        android:lineSpacingExtra="4dp"
                        android:text="• Track daily Income &amp; Expense transactions\n• Manage multiple accounts &amp; custom categories\n• Export PDF statements &amp; detailed reports\n• 100% Offline, Fast &amp; Secure"
                        android:textColor="@color/subTextColor"
                        android:textSize="@dimen/_10ssp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Check for Update Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCheckUpdate"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_46sdp"
                android:layout_marginTop="@dimen/_18sdp"
                android:fontFamily="@font/bold"
                android:text="Check for Update"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="@dimen/_13ssp"
                app:backgroundTint="@color/primaryColor"
                app:cornerRadius="@dimen/_12sdp"
                app:elevation="0dp"
                app:layout_constraintTop_toBottomOf="@id/cardFeatures" />

            <!-- Footer Copyright -->
            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/txtCopyright"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_16sdp"
                android:fontFamily="@font/medium"
                android:text="Expense Tracker • All Rights Reserved"
                android:textColor="@color/subTextColor"
                android:textSize="@dimen/_10ssp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/btnCheckUpdate" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
