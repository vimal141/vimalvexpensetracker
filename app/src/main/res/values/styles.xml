<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="TextAppearance.App.Headline" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textSize">24sp</item>
        <item name="android:textColor">@color/TextColor</item>
        <item name="android:fontFamily">sans-serif-black</item>
    </style>

    <style name="TextAppearance.App.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/TextColor</item>
        <item name="android:fontFamily">sans-serif-black</item>
    </style>

    <style name="TextAppearance.App.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/TextColor</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="Widget.App.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">@color/bgColorCard</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <style name="Widget.App.PrimaryButton" parent="Widget.Material3.Button">
        <item name="cornerRadius">8dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="backgroundTint">@color/primaryColor</item>
        <item name="android:textColor">@color/textOnPrimary</item>
        <item name="android:minHeight">45dp</item>
    </style>

    <style name="BottomNavActiveText" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:fontFamily">@font/semi_bold</item>
        <item name="fontFamily">@font/semi_bold</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textSize">@dimen/_9ssp</item>
    </style>

    <style name="BottomNavInactiveText" parent="TextAppearance.Material3.LabelSmall">
    <item name="android:fontFamily">@font/regular</item>
    <item name="android:includeFontPadding">false</item>
    <item name="fontFamily">@font/regular</item>
    <item name="android:textSize">@dimen/_9ssp</item>
    </style>
</resources>